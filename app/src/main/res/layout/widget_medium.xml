<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Dot -->
        <ImageView
            android:id="@+id/iv_medium_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_status_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_medium_market_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="LIVE IST"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_medium_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="• Updated Just now"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5sp" />

        <ImageButton
            android:id="@+id/btn_medium_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/refresh_tooltip"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- Indices 2-Column Split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: NIFTY 50 -->
        <LinearLayout
            android:id="@+id/layout_medium_nifty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="NIFTY 50"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="NSE"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_medium_nifty_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="24,941.55"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_medium_nifty_trend"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trending_up" />

                <TextView
                    android:id="@+id/tv_medium_nifty_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+125.60 (+0.48%)"
                    android:textColor="@color/positive_green"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@color/widget_divider"
            android:contentDescription="@null" />

        <!-- Right: SENSEX -->
        <LinearLayout
            android:id="@+id/layout_medium_sensex"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="SENSEX"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="BSE"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_medium_sensex_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="80,777.45"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_medium_sensex_trend"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trending_down" />

                <TextView
                    android:id="@+id/tv_medium_sensex_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="-245.30 (-0.29%)"
                    android:textColor="@color/negative_red"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
